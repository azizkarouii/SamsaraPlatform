# For docker compose: copy to .env (never committed) and fill in.

# --- Required
DB_PASSWORD=
# At least 32 characters. Generate one: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# --- Address of the site, as users type it (links in the emails, allowed origin of the API)
APP_URL=http://localhost:8080
# Port of the site on this machine
HTTP_PORT=8080

# --- Session cookie only over HTTPS. Browsers accept it on http://localhost; set false only to test on another http address.
COOKIE_SECURE=true
# "Today" for stays, payments and reminders: the time zone of the houses, whatever the server's clock
APP_TIMEZONE=Africa/Tunis
# New accounts confirm their email. Without SMTP below, set false (or read the link in: docker compose logs backend).
EMAIL_VERIFICATION=true

# --- Emails (confirmation, password reset, reminders)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com

# --- Photos: on a Docker volume by default; any S3-compatible service otherwise
STORAGE_TYPE=local
# STORAGE_TYPE=s3
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=samsara
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE_URL=https://photos.example.com
