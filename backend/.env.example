# Copy to backend/.env and fill in. In production, set these as environment variables instead.

# --- Required
DB_PASSWORD=
# At least 32 characters. Generate one: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# --- Optional (defaults suit local development)
# DB_URL=jdbc:postgresql://localhost:5432/Samsara
# DB_USERNAME=postgres
# PORT=3001
# FRONTEND_URL=http://localhost:4300
# CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# --- Password reset emails. Without a mail server, the reset link is written to the backend log.
# spring.mail.host=smtp.example.com
# spring.mail.port=587
# spring.mail.username=
# spring.mail.password=
# spring.mail.properties.mail.smtp.auth=true
# spring.mail.properties.mail.smtp.starttls.enable=true
# MAIL_FROM=no-reply@example.com

# --- Photos in a cloud storage instead of the local disk (any S3-compatible service)
# STORAGE_TYPE=s3
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=samsara
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE_URL=https://photos.example.com
